# ============================================================================
# WORLD Strategy Environment Configuration
# ============================================================================

# Network
NEXT_PUBLIC_NETWORK=devnet
RPC_ENDPOINT=https://api.devnet.solana.com

# Keeper Bot
DRY_RUN=true
LOG_LEVEL=debug
KEEPER_CHECK_INTERVAL_MS=30000

# On-chain Program
NEXT_PUBLIC_PROGRAM_ID=7DXPpkN3YFh6pjAWQJfhiBSXnwWhVJEbHRQy2MFPdx4H
NEXT_PUBLIC_TREASURY_ACCOUNT=TreasuryAccountPublicKeyPlaceholder1234567
NEXT_PUBLIC_TREASURY_MINT=WORLD111111111111111111111111111111111111111

# Oracle Configuration
ORACLE_TYPE=mock
PYTH_NETWORK_ID=ExamplePythNetworkId

# DEX Aggregator
DEX_AGGREGATOR=jupiter
JUPITER_QUOTE_ENDPOINT=https://quote-api.jup.ag/v4/quote

# Asset Configuration
CONFIG_PATH=./src/config/default.json

# Node Operator (optional, for keeper sig)
KEEPER_KEYPAIR=~/.config/solana/id.json
KEEPER_RPC_COMMITMENT=confirmed

# Dashboard
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Slack Alerts (optional)
SLACK_WEBHOOK_URL=
ALERT_ON_EXECUTION=true

# Debug
DEBUG_MODE=false
VERBOSE_LOGS=false
